rules_version = '2';
// Demo rules: anyone can read, anyone can add a plan, nobody can change or delete one.
// Before real use: require sign-in for writes and keep farmer references out of public reads.
service cloud.firestore {
  match /databases/{database}/documents {
    match /plans/{id} {
      allow read: if true;
      allow create: if request.resource.data.districtId is string
                    && request.resource.data.areaHa is number
                    && request.resource.data.areaHa > 0
                    && request.resource.data.areaHa < 1000
                    && request.resource.data.keys().size() <= 12;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
